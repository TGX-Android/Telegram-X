diff --git a/app/src/main/java/org/thunderdog/challegram/unsorted/StartMarks.kt b/app/src/main/java/org/thunderdog/challegram/unsorted/StartMarks.kt
new file mode 100644
index 0000000..b789117
--- /dev/null
+++ b/app/src/main/java/org/thunderdog/challegram/unsorted/StartMarks.kt
@@ -0,0 +1,33 @@
+@file:JvmName("StartMarks")
+
+package org.thunderdog.challegram.unsorted
+
+import android.os.Looper
+import android.os.SystemClock
+import android.util.Log
+import org.thunderdog.challegram.config.Config
+
+// Marks along the start of the app, for phones whose Android has no traces of apps, e.g. 4.2.
+// Each logs with tag StartMarks its name, the milliseconds since the previous mark and since the
+// first one, once for each process, in builds with test hooks only
+
+private var firstMark = 0L
+private var lastMark = 0L
+private val marked = HashSet<String>()
+
+@Synchronized
+fun startMark(name: String) {
+  if (!Config.ENABLE_TEST_HOOKS || !marked.add(name)) {
+    return
+  }
+  val now = SystemClock.uptimeMillis()
+  if (firstMark == 0L) {
+    firstMark = now
+    lastMark = now
+  }
+  // Marks of other threads than the main one name their thread
+  val main = Looper.myLooper() == Looper.getMainLooper()
+  val thread = if (main) "" else " @${Thread.currentThread().name}"
+  Log.i("StartMarks", "$name$thread +${now - lastMark} ms, ${now - firstMark} ms")
+  lastMark = now
+}
